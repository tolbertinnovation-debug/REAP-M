# Copy to .env for Docker Compose. Never commit a filled .env file.
NODE_ENV=production
DEMO_MODE=false
PORT=3000
HOST=0.0.0.0
DB_PATH=/app/data/market.sqlite
PUBLIC_ORIGIN=https://market.example.org
MARKET_DOMAIN=market.example.org
# Used ONLY to bootstrap the first administrator in a fresh live database.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Integer USD cents. Confirm the real delivery area and fee before launch.
DELIVERY_FEE_CENTS=500
DELIVERY_AREA=Bentol City and Monrovia
SUPPORT_EMAIL=
SUPPORT_WHATSAPP=
# Enable only behind the supplied trusted reverse proxy.
TRUST_PROXY=true
# Outbound messaging is off by default. No credentials belong in frontend files.
ENABLE_OUTBOUND=false
RESEND_API_KEY=
EMAIL_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
